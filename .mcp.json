{
  "mcpServers": {
    "mysql": {
      "command": "uvx",
      "args": [
        "mcp-server-mysql"
      ],
      "env": {
        "MYSQL_CONNECTION_STRING": "mysql://root:@127.0.0.1:3310/kasabazaar"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "infobip-sms": {
      "type": "http",
      "url": "https://mcp.infobip.com/sms",
      "headers": {
        "Authorization": "App ${INFOBIP_SMS_API_KEY}"
      }
    },
    "infobip-whatsapp": {
      "type": "http",
      "url": "https://mcp.infobip.com/whatsapp",
      "headers": {
        "Authorization": "App ${INFOBIP_WHATSAPP_API_KEY}"
      }
    }
  }
}
