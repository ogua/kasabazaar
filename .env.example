APP_NAME=KASAROSE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kmarket
DB_USERNAME=root
DB_PASSWORD=

# kasabazaar backend integration — kmarket talks to it strictly over this API,
# never a shared database connection.
KASABAZAAR_API_URL=http://localhost:8000/api/v1
KMARKET_CHECKOUT_CALLBACK_URL="${APP_URL}/checkout/callback"

# ─── KasaBazaar Group of Companies ─────────────────────────────────────────
# Cross-site links rendered by the storefront footer, About page and legal
# pages. See config/group.php — the same roster is mirrored in the group site,
# RDD Shipping and Neoride repositories.
GROUP_SITE_URL=https://kasabazaar.com
RDD_SITE_URL=https://rddshipping.com
NEORIDE_SITE_URL=https://neorideafrica.com

# ─── CONFIRM BEFORE LAUNCH ─────────────────────────────────────────────────
# The four settings below are published verbatim on the legal pages, so they
# must be verified — not guessed — before this site goes live.
#
#   APP_URL             the production domain (also feeds canonical URLs,
#                       robots.txt and the sitemap). Currently unset for
#                       production.
#   GROUP_LEGAL_NAME    the registered entity that operates KASAROSE. Left
#                       unset it falls back to the trading name "KASAROSE",
#                       which is true but is not a legal entity. Set it once
#                       the company registration is confirmed.
#   SUPPORT_ADDRESS     the registered office. Left unset, the templates omit
#                       the address sentence entirely rather than print a
#                       placeholder — an empty value is safe, a wrong one is
#                       not.
#   SUPPORT_EMAIL       defaults to the group's published support address.
#                       Point it at a KASAROSE mailbox once one exists, and
#                       set LEGAL_EMAIL / PRIVACY_EMAIL only if those are
#                       separate inboxes (they fall back to SUPPORT_EMAIL).
#
# Phone numbers below are the group's published lines and are already correct.
GROUP_LEGAL_NAME=
SUPPORT_ADDRESS=

SUPPORT_EMAIL=support@kasabazaar.com
LEGAL_EMAIL=
PRIVACY_EMAIL=
SUPPORT_PHONE_GH="+233 50 972 5081"
SUPPORT_PHONE_GH_TEL=+233509725081
SUPPORT_PHONE_US="+1 (574) 440-7460"
SUPPORT_PHONE_US_TEL=+15744407460

# Click-to-WhatsApp floating contact button (storefront layout). Digits only,
# with country code, e.g. 233551234567. Leave blank to hide the button.
WHATSAPP_NUMBER=

# Stripe Elements on the checkout callback page. Leave blank if Paystack is
# the only enabled gateway.
STRIPE_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@kasabazaar.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
